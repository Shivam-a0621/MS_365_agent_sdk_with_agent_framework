# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ---- App ----
APP_NAME=agent-fastapi
HOST=0.0.0.0
PORT=3978
DEBUG=true

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>

# ---- AutomationEdge MCP (SSE) ----
AE_MCP_URL=http://localhost:8090/sse

# ---- Database (Postgres) ----
AISTUDIOBOT_DB_NAME=agent-fastapi
AISTUDIOBOT_DB_USER=postgres
AISTUDIOBOT_DB_PASS=<your-db-password>
AISTUDIOBOT_DB_HOST=localhost
AISTUDIOBOT_DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Bot credentials (MS 365 Agents SDK) ----
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<your-bot-client-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<your-bot-client-secret>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<your-tenant-id>
